DATABASE_URL=sqlite:///./infradealer.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
ADMIN_TOKEN=
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
OTP_TTL_SECONDS=300
REF_TTL_HOURS=48
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_SYSTEM_USER_TOKEN=
META_VERIFY_TOKEN=
META_TEST_RECIPIENT=
AI_ENABLED=true
AI_API_KEY=
AI_API_BASE=https://api.z.ai/api/paas/v4
AI_MODEL=glm-4.5-flash
AI_SIMPLE_CHAT=false
AI_MEDIA_DIR=./data/media
REDIS_URL=

# InfraDealer marketplace API (Admin → Webhook API se key/secret generate karein)
# Callback URL: {PUBLIC_BASE_URL}/api/v1/integrations/infradealer/callback
INFRADEALER_BASE_URL=https://api.infradealer.com
INFRADEALER_API_KEY=
INFRADEALER_API_SECRET=
INFRADEALER_API_VERSION=v1
INFRADEALER_TIMEOUT=30
INFRADEALER_MAX_RETRIES=3
INFRADEALER_MODE=LIVE
# Marketplace queues WhatsApp listings as pending — keep false
INFRADEALER_AUTO_PUBLISH=false

# OTP via India DLT SMS only (never WhatsApp). SMS_PROVIDER=log|textguru|msg91|http
SMS_ENABLED=true
SMS_PROVIDER=textguru
SMS_API_KEY=
SMS_API_URL=https://www.textguru.in/api/v22.0/
SMS_SENDER_ID=AREANS
SMS_DLT_TEMPLATE_ID=1777178540657949209
SMS_DLT_ENTITY_ID=
SMS_OTP_TEMPLATE=Your OTP for InfraDealer is {otp}. The OTP is valid for 10 minutes. Please do not share this OTP with anyone. Regards, AREANS
# Same credentials as api.infradealer.com (/docker/infra/.env)
TEXTGURU_API_URL=https://www.textguru.in/api/v22.0/
TEXTGURU_USERNAME=
TEXTGURU_PASSWORD=
TEXTGURU_SENDER_ID=AREANS
TEXTGURU_DLT_TEMPLATE_ID=1777178540657949209
TEXTGURU_SERVICE=OTP
TEXTGURU_MESSAGE_TEMPLATE=Your OTP for InfraDealer is {OTP}. The OTP is valid for 10 minutes. Please do not share this OTP with anyone. Regards, AREANS
